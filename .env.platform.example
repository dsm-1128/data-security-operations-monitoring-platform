# Copy to .env.platform and replace passwords. Development defaults explicitly use simulated model/tools.
SECOPS_MODE=development
SECOPS_PLATFORM_PORT=18081
SECOPS_PUBLIC_URL=http://127.0.0.1:18081
SECOPS_ALLOWED_HOSTS=127.0.0.1,localhost
SECOPS_DB_PASSWORD=replace-with-random-password
SECOPS_DB_ROOT_PASSWORD=replace-with-another-random-password
SECOPS_REDIS_PASSWORD=replace-with-random-redis-password
SECOPS_MODEL_MODE=simulated
# single (default) or multi: Supervisor + four scoped professional agents
SECOPS_AGENT_ARCH=single
SECOPS_LLM_BASE_URL=
SECOPS_LLM_MODEL=
SECOPS_LLM_API_KEY=
SECOPS_CONNECTOR_MODE=simulated
SECOPS_CONNECTOR_URL=
SECOPS_CONNECTOR_TOKEN=
SECOPS_CONNECTOR_VERSION=v1
SECOPS_OIDC_ISSUER=
SECOPS_OIDC_CLIENT_ID=
SECOPS_OIDC_CLIENT_SECRET=
SECOPS_IDENTITIES_FILE=/app/config/identities.json
SECOPS_ATTACHMENT_BUCKET=
SECOPS_ATTACHMENT_ENDPOINT=
SECOPS_MAX_ROUNDS=12
# For multi/live or repeated investigations, explicitly consider 24 (allowed 1-48).
# Budgets remain global; enabling multi never raises them automatically.
SECOPS_MAX_TOOLS=24
SECOPS_MAX_SECONDS=300
SECOPS_MAX_TOKENS=64000
SECOPS_TRACE_CONSOLE=1
